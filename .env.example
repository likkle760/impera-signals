# ── Database ─────────────────────────────────────────────
# PostgreSQL connection string. When set, users + license keys are persisted in
# the cloud (survives redeploys on any host, no disk needed). Leave empty to
# fall back to a local data/portal.json file.
DATABASE_URL=postgresql://user:password@host:5432/impera
# Set to "false" only if your database does not require SSL.
DATABASE_SSL=true

# ── Portal data directory ─────────────────────────────────
# Where the server persists users + license keys (portal.json).
# Defaults to <project>/data. On Render/trigger.dev mount your persistent
# disk here, e.g. DATA_DIR=/data
DATA_DIR=/data

# ── Redis (caching / real-time fan-out, optional) ────────
REDIS_URL=redis://localhost:6379

# ── Market Data Provider ─────────────────────────────────
# Leave empty to run in DEMO MODE with simulated data.
MARKET_DATA_PROVIDER=demo
MARKET_DATA_API_KEY=
MARKET_DATA_API_URL=
# For a WebSocket streaming provider:
MARKET_DATA_WS_URL=

# ── News / Economic Calendar API (optional) ──────────────
# Leave empty to show "NEWS DATA UNAVAILABLE".
NEWS_API_KEY=
NEWS_API_URL=

# ── Notifications (optional) ─────────────────────────────
# Browser notifications work out of the box.
# Telegram / Discord can be added through the NotificationEngine layer.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=IMPERA SIGNALS V1
NEXT_PUBLIC_DEFAULT_SCAN_SECONDS=30

# ── Portal (access control) ──────────────────────────────
# Seeded on first run. CHANGE THE DEFAULT PASSWORD before going public.
PORTAL_ADMIN_EMAIL=Imperafrx@gmail.com
PORTAL_ADMIN_PASSWORD=Nezoba24
# How many license keys to pre-generate (IMPERA-XXXX-XXXX-XXXX)
PORTAL_LICENSE_COUNT=1000
